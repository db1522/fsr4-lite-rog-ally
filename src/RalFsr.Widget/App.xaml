<Application
    x:Class="RalFsr.Widget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="RalRed">#E50007</Color>
            <SolidColorBrush x:Key="RalRedBrush" Color="#E50007" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F21B1D22" />
            <SolidColorBrush x:Key="CardBrush" Color="#FF262930" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FFA3A9B4" />
            <SolidColorBrush x:Key="GoodBrush" Color="#FF39C27A" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFE8A23A" />
            <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>

            <!-- No BasedOn: the default Button template is used, and colours come from the button's own resources
                 (WidgetPage.xaml), so hover and pressed states stay red instead of turning grey. -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
